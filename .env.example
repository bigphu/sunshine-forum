# Biến cho compose.yml (sao chép thành .env: make init). Chỉ dùng cho dev.

# Postgres của forum (stack riêng, không dùng chung với StoreIt)
APP_DB_NAME=sunshine
APP_DB_USER=sunshine
DB_PORT=5441

# Cổng trên host
APP_PORT=8091
WEB_PORT=5180
MAILPIT_PORT=8026

# Quản trị viên đầu tiên, tạo khi DB chưa có tài khoản nào
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Mật khẩu của tài khoản demo (make seed); để trống thì make seed báo lỗi
SEED_PASSWORD=sunshine-demo
