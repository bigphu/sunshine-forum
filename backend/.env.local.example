# Env cho Go chạy trên host (make run-api, run-worker, test...). Sao chép thành .env.local
# (make init). Đường dẫn *_FILE tính từ backend/; Makefile đổi sang đường dẫn tuyệt đối.
# Postgres là service postgres của compose.yml (make up hoặc docker compose up -d postgres).

DB_URL=postgres://sunshine@127.0.0.1:5441/sunshine?sslmode=disable
PGPASSWORD_FILE=../deploy/secrets/pg_password.txt

PRIVACY_ENC_KEY_FILE=../deploy/secrets/privacy_enc_key.txt
PRIVACY_HMAC_KEY_FILE=../deploy/secrets/privacy_hmac_key.txt

HTTP_ADDR=127.0.0.1:8091
HTTP_API_DOCS=true
LOG_FORMAT=pretty
LOG_LEVEL=info

IDENTITY_COOKIE_SECURE=false
IDENTITY_APP_URL=http://localhost:5180

# Worker: thư đi vào Mailpit (http://localhost:8026)
MAIL_TRANSPORT=smtp
MAIL_FROM=Sunshine Apartment <no-reply@sunshine.test>
MAIL_SMTP_HOST=127.0.0.1
MAIL_SMTP_PORT=1026
MAIL_SMTP_TLS=none

SEED_PASSWORD=sunshine-demo
