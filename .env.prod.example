# Biến cho compose.prod.yml (sao chép thành .env trên server). Secrets nằm trong
# deploy/secrets/ (sh deploy/scripts/init.sh), không nằm ở đây.

APP_DB_NAME=sunshine
APP_DB_USER=sunshine

# Cổng của container web trên 127.0.0.1; host nginx (deploy/nginx) trỏ vào đây
WEB_PORT=8092

# Địa chỉ công khai, dùng trong link của thư mời và thư đặt lại mật khẩu
APP_URL=https://sunshine-forum.bigphu.io.vn
MAIL_FROM=Sunshine Apartment <no-reply@bigphu.io.vn>

# Dịch vụ mô hình: image build bằng make model-image MODEL_TAG=... (cần model/models/svm_final.joblib).
# Bỏ comment SCREENING_MODEL_URL= (rỗng) để chạy không có mô hình, dùng StandIn (điểm mẫu).
MODEL_TAG=latest
#SCREENING_MODEL_URL=

# Quản trị viên đầu tiên, tạo khi DB chưa có tài khoản nào. Xoá sau lần chạy đầu.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Ảnh build bằng make images TAG=vX.Y.Z
REGISTRY=sunshine-forum
TAG=latest
